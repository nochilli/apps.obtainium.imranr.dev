---
import { getCurrentLanguage, getLocalizedStrings } from "../lib/i18n";
import KeepAndroidOpenBanner from "../components/KeepAndroidOpenBanner.astro";
import "../styles/global.css";

const { title } = Astro.props;
const currentLanguage = await getCurrentLanguage(Astro.url, Astro.request);
const translations = getLocalizedStrings(currentLanguage);

const siteTitle = title
  ? `${title} | ${translations["title"]}`
  : translations["title"];
const siteDescription =
  translations["subtitle"] || "Crowdsourced app configurations for Obtainium";

const plausibleUrl =
  import.meta.env.PUBLIC_PLAUSIBLE_URL ||
  "https://plausible.imranr.dev/js/pa-hfruFX__Q49EFCqqzfuH3.js";
const adsenseId =
  import.meta.env.PUBLIC_ADSENSE_ID ||
  "ca-pub-6629162404802829";
---

<!doctype html>
<html class="h-full" lang={currentLanguage}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="theme-color" content="#6438B5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A0E4A" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://raw.githubusercontent.com" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: translations["title"],
      description: siteDescription,
      url: Astro.url.origin,
    })}></script>
    <noscript>
      <style>
        .jsonly {
          display: none;
        }
      </style>
    </noscript>
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src={plausibleUrl}></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`}
      crossorigin="anonymous"></script>
  </head>
  <body
    class="text-text min-h-screen flex flex-col relative overflow-x-hidden"
    style="font-family: 'Montserrat', system-ui, sans-serif;"
  >
    <KeepAndroidOpenBanner translations={translations} />
    <header class="relative z-20">
      <div class="container mx-auto px-4">
        <div class="flex items-center justify-between py-4 md:py-5">
          <a href="/" class="group flex items-center gap-2.5" aria-label={translations["title"]}>
            <img src="/favicon.png" alt="" width="36" height="36" class="shrink-0 w-9 h-9 rounded-xl" />
            <span class="flex items-center gap-1.5 leading-none">
              <span class="text-xs sm:text-sm uppercase tracking-widest text-primary-600 font-bold">
                {translations["title"]}
              </span>
            </span>
          </a>

          <nav class="flex items-center sm:gap-1.5" aria-label="Main">
            <a
              href="https://wiki.obtainium.imranr.dev/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-1 py-2 text-sm font-medium text-text-secondary hover:text-text transition-colors duration-200"
            >
              {translations["about"]}
            </a>
            <a
            href="https://github.com/ImranR98/apps.obtainium.imranr.dev/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="px-1 py-2 text-sm font-medium text-text-secondary hover:text-text transition-colors duration-200"
            >
            <span>{translations["contribute"]}</span>
          </a>
          <a
            href="https://plausible.imranr.dev/apps.obtainium.imranr.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="px-1 py-2 text-sm font-medium text-text-secondary hover:text-text transition-colors duration-200"
          >
            {translations["analytics"]}
            </a>
          </nav>
        </div>
      </div>
    </header>

    <main class="grow relative z-10">
      <slot />
    </main>

    <footer class="relative z-10 mt-12 border-t border-border bg-surface/60">
      <div class="container mx-auto px-4 py-8">
        <div class="flex flex-col items-center justify-between gap-6 md:flex-row">

          <nav class="flex flex-wrap items-center justify-center gap-2 sm:gap-3" aria-label="Footer">
            <a
              href="/"
              class="px-3 py-1.5 text-xs sm:text-sm font-medium rounded-full text-text-secondary hover:text-text hover:bg-surface-hover transition-colors duration-200"
            >
              {translations["goHome"]}
            </a>
            <a
              href="/apps"
              class="px-3 py-1.5 text-xs sm:text-sm font-medium rounded-full text-text-secondary hover:text-text hover:bg-surface-hover transition-colors duration-200"
            >
              {translations["apps"]}
            </a>
            <a
              href="/categories"
              class="px-3 py-1.5 text-xs sm:text-sm font-medium rounded-full text-text-secondary hover:text-text hover:bg-surface-hover transition-colors duration-200"
            >
              {translations["categories"]}
            </a>
            <a
              href="https://github.com/ImranR98/apps.obtainium.imranr.dev"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 text-xs sm:text-sm font-medium rounded-full text-text-secondary hover:text-text hover:bg-surface-hover transition-colors duration-200"
            >
              {translations["contribute"]}
            </a>
            <a
              href="https://github.com/ImranR98/Obtainium"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 text-xs sm:text-sm font-medium rounded-full text-text-secondary hover:text-text hover:bg-surface-hover transition-colors duration-200"
            >
              {translations["source"]}
            </a>
          </nav>
          <p class="text-xs text-text-subtle">
            © {new Date().getFullYear()} Imran R
          </p>
        </div>
      </div>
    </footer>

  </body>
</html>

<script is:inline>
  (() => {
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        const targetId = this.getAttribute("href");
        if (targetId === "#") return;
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });
  })();
</script>
